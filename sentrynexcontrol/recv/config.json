{
    "embed": {
        "model_name": "dinov2_vits14",
        "img_size": 560,
        "global_mode": "patch_mean"
    },
    "repr": {
        "repr_mode": "global_patch"
    },
    "patchcore": {
        "top_p": 0.1,
        "preselect_m": 15
    },
    "calib": {
        "k": 3,
        "method": "robust",
        "gaussian_k": 2.5,
        "robust_k": 2.5,
        "percentile": 97
    },
    "infer": {
        "event_rule": "median",
        "use_two_stage_vlm": false
    }
}